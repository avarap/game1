[gd_resource type="Resource" script_class="DialogueData" load_steps=17 format=3]

[ext_resource type="Script" path="res://systems/dialogue/dialogue_data.gd" id="1_dialogue"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_node_data.gd" id="2_node"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_option_data.gd" id="3_option"]
[ext_resource type="Script" path="res://systems/dialogue/dialogue_condition_data.gd" id="4_condition"]

[sub_resource type="Resource" id="ConditionTrusted"]
script = ExtResource("4_condition")
condition_type = 1
relationship_id = &"brother_aldren"
minimum_relationship = 10

[sub_resource type="Resource" id="ConditionNight"]
script = ExtResource("4_condition")
condition_type = 3
start_hour = 22
end_hour = 6

[sub_resource type="Resource" id="OptionFirstTask"]
script = ExtResource("3_option")
id = &"first_task"
text_key = &"DIALOGUE_ALDREN_OPTION_FIRST_TASK"
next_node_id = &"first_task_response"

[sub_resource type="Resource" id="OptionIdentity"]
script = ExtResource("3_option")
id = &"identity"
text_key = &"DIALOGUE_ALDREN_OPTION_IDENTITY"
next_node_id = &"identity_response"

[sub_resource type="Resource" id="OptionNight"]
script = ExtResource("3_option")
id = &"night_warning"
text_key = &"DIALOGUE_ALDREN_OPTION_NIGHT"
next_node_id = &"night_warning_response"
conditions = Array[ExtResource("4_condition")]([SubResource("ConditionNight")])

[sub_resource type="Resource" id="OptionTrusted"]
script = ExtResource("3_option")
id = &"trusted_question"
text_key = &"DIALOGUE_ALDREN_OPTION_TRUSTED"
next_node_id = &"trusted_response"
conditions = Array[ExtResource("4_condition")]([SubResource("ConditionTrusted")])

[sub_resource type="Resource" id="OptionGoodbye"]
script = ExtResource("3_option")
id = &"goodbye"
text_key = &"DIALOGUE_ALDREN_OPTION_GOODBYE"
next_node_id = &"goodbye_response"

[sub_resource type="Resource" id="NodeIntro"]
script = ExtResource("2_node")
id = &"intro"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_INTRO"
options = Array[ExtResource("3_option")]([SubResource("OptionFirstTask"), SubResource("OptionIdentity"), SubResource("OptionNight"), SubResource("OptionTrusted"), SubResource("OptionGoodbye")])

[sub_resource type="Resource" id="NodeFirstTask"]
script = ExtResource("2_node")
id = &"first_task_response"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_FIRST_TASK_RESPONSE"

[sub_resource type="Resource" id="NodeIdentity"]
script = ExtResource("2_node")
id = &"identity_response"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_IDENTITY_RESPONSE"

[sub_resource type="Resource" id="NodeNight"]
script = ExtResource("2_node")
id = &"night_warning_response"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_NIGHT_RESPONSE"

[sub_resource type="Resource" id="NodeTrusted"]
script = ExtResource("2_node")
id = &"trusted_response"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_TRUSTED_RESPONSE"

[sub_resource type="Resource" id="NodeGoodbye"]
script = ExtResource("2_node")
id = &"goodbye_response"
speaker_id = &"brother_aldren"
speaker_name_key = &"NPC_BROTHER_ALDREN_NAME"
text_key = &"DIALOGUE_ALDREN_GOODBYE_RESPONSE"

[resource]
script = ExtResource("1_dialogue")
id = &"brother_aldren_introduction"
start_node_id = &"intro"
nodes = Array[ExtResource("2_node")]([SubResource("NodeIntro"), SubResource("NodeFirstTask"), SubResource("NodeIdentity"), SubResource("NodeNight"), SubResource("NodeTrusted"), SubResource("NodeGoodbye")])
