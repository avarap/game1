[gd_resource type="Resource" script_class="RecipeData" load_steps=7 format=3]

[ext_resource type="Script" path="res://systems/crafting/recipe_data.gd" id="1_recipe"]
[ext_resource type="Script" path="res://systems/crafting/recipe_ingredient.gd" id="2_ingredient"]
[ext_resource type="Resource" path="res://data/items/wood.tres" id="3_wood"]
[ext_resource type="Resource" path="res://data/items/plank.tres" id="4_plank"]

[sub_resource type="Resource" id="InputWood"]
script = ExtResource("2_ingredient")
