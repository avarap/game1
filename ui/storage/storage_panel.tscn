[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/theme/core_list_panel.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/theme/game_ui_theme.tres" id="2_theme"]

[node name="StoragePanel" type="PanelContainer"]
custom_minimum_size = Vector2(420, 360)
theme = ExtResource("2_theme")
script = ExtResource("1_script")
title_key = &"UI_PANEL_STORAGE_TITLE"

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18

[node name="VBox" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
theme_type_variation = &"PanelTitle"
text = "Storage"

[node name="State" type="Label" parent="Margin/VBox"]
text = "Select an entry."

[node name="Rows" type="VBoxContainer" parent="Margin/VBox"]
size_flags_vertical = 3
theme_override_constants/separation = 6
